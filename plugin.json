{
  "id": "discord",
  "kind": "plugin",
  "version": "1.1.21",
  "label": "Discord",
  "description": "Discord bot chat, !ducky commands, Rich Presence, and agent server-admin tools in UEFN Ducky",
  "min_app_version": "1.2.357",
  "default_enabled": true,
  "data_sharing": false,
  "secret_keys": [
    "discord",
    "discord_guild",
    "discord_name",
    "discord_allowed_ids",
    "discord_channel",
    "discord_notify_webhook"
  ],
  "contributes": {
    "ui.panels": [
      {
        "id": "discord-settings",
        "title": "Discord settings",
        "icon": "assets/icon.png",
        "entry": "ui/settings.html"
      },
      {
        "id": "discord-chat",
        "title": "Discord Ducky",
        "icon": "assets/icon.png",
        "entry": "ui/chat.html"
      }
    ],
    "settings.tabs": [
      {
        "id": "Discord",
        "label": "Discord",
        "icon": "assets/icon.png",
        "ui": "panel:discord-settings"
      }
    ],
    "walkthrough": {
      "id": "discord",
      "title": "Discord Ducky setup",
      "auto_start": "first_enable",
      "settings_tab": "Discord",
      "steps": [
        {
          "target": "settings.tab.discord",
          "title": "Discord settings",
          "body": "Bot token and server ID are configured here. Header buttons live under Appearance \u2192 Header. Dock panels live under Appearance \u2192 Sidebar. Press Discord to open the tab.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.content",
          "title": "Connection",
          "body": "Add a bot, paste your token and guild ID. Optional: Incoming Webhook URL to ping you when a Ducky app job finishes. Appearance \u2192 Header and Appearance \u2192 Sidebar control where Discord Ducky appears.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.content",
          "title": "Using Discord Ducky",
          "body": "Open Discord Ducky from the header button or left dock to chat, run !ducky commands, and manage the server.",
          "advance": "next",
          "mode": "rect"
        }
      ]
    },
    "dock.panels": [
      {
        "id": "groupchat",
        "title": "Discord Ducky",
        "defaultSide": "left",
        "ui": "panel:discord-chat"
      }
    ],
    "header.buttons": [
      {
        "id": "discord",
        "title": "Discord Ducky",
        "icon": "assets/icon.png",
        "action": "panel:discord-chat",
        "order": 10
      }
    ],
    "agent.tools": {
      "category": "discord",
      "intent_pattern": "\\b(discord(\\s+bot)?|ducky\\s*bob|bob\\s*bob|bots?|group\\s*chat|the\\s+server\\s+chat|community\\s+chat|server\\s+(admin|manage|setup)|channels?|roles?|permissions?)\\b",
      "plan_tools": [
        "discord_list_bots",
        "discord_list_channels",
        "discord_read_channel",
        "discord_list_roles",
        "discord_list_members"
      ],
      "destructive_tools": [
        "discord_delete_channel",
        "discord_delete_role",
        "discord_kick_member",
        "discord_ban_member",
        "discord_delete_message",
        "discord_timeout_member"
      ]
    },
    "automations": {
      "triggers": [
        {
          "id": "discord.message",
          "label": "Discord message",
          "group": "Triggers",
          "description": "Human message on the Gateway. Empty channel_id matches every channel.",
          "config_fields": [
            {
              "id": "channel_id",
              "label": "Channel id (optional)",
              "type": "string"
            }
          ]
        }
      ],
      "nodes": [
        {
          "id": "discord.send",
          "label": "Send Discord message",
          "group": "Discord",
          "description": "Post as the bot. Empty fields use the trigger payload.",
          "config_fields": [
            {
              "id": "channel_id",
              "label": "Channel id",
              "type": "string"
            },
            {
              "id": "text",
              "label": "Text",
              "type": "textarea"
            }
          ]
        }
      ],
      "templates": [
        {
          "id": "discord-spawn-ducky",
          "label": "Discord starts a ducky",
          "icon": "\ud83d\udcac",
          "description": "A human Discord message spawns a ducky with that text. Ready as-is.",
          "graph": {
            "nodes": [
              {
                "id": "t",
                "type": "discord.message",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Discord message",
                "description": "Human message on the Gateway"
              },
              {
                "id": "s",
                "type": "ducky.spawn",
                "x": 300,
                "y": 80,
                "config": {
                  "title": "Discord",
                  "prompt": ""
                },
                "label": "Spawn ducky",
                "description": "Uses the Discord message as the prompt"
              }
            ],
            "edges": [
              {
                "source": "t",
                "target": "s",
                "kind": "main"
              }
            ]
          }
        },
        {
          "id": "discord-spawn-ack",
          "label": "Discord ducky + On it",
          "icon": "\ud83e\udd16",
          "description": "Spawn a ducky from the message and reply On it. in Discord.",
          "graph": {
            "nodes": [
              {
                "id": "t",
                "type": "discord.message",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Discord message",
                "description": "Human message on the Gateway"
              },
              {
                "id": "s",
                "type": "ducky.spawn",
                "x": 280,
                "y": 80,
                "config": {
                  "title": "Discord",
                  "prompt": ""
                },
                "label": "Spawn ducky",
                "description": "Uses the Discord message as the prompt"
              },
              {
                "id": "r",
                "type": "discord.send",
                "x": 520,
                "y": 80,
                "config": {
                  "channel_id": "",
                  "text": "On it."
                },
                "label": "Send Discord message",
                "description": "Replies in the same channel"
              }
            ],
            "edges": [
              {
                "source": "t",
                "target": "s",
                "kind": "main"
              },
              {
                "source": "s",
                "target": "r",
                "kind": "main"
              }
            ]
          }
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
